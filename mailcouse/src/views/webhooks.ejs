<div class="serverHeader">
  <div class="serverHeader__stripe serverHeader__stripe--<%= serverMode %>"><%= serverMode.charAt(0).toUpperCase() + serverMode.slice(1) %></div>
  <div class="serverHeader__info">
    <p class="serverHeader__title">Mail Server</p>
    <ul class="serverHeader__list">
      <li class="serverHeader__list--ok">DKIM &amp; SPF configured correctly</li>
    </ul>
  </div>
</div>
<nav class="navBar">
  <ul>
    <li class="navBar__item"><a href="/portal/dashboard" class="navBar__link">Overview</a></li>
    <li class="navBar__item"><a href="/portal/messages" class="navBar__link">Messages</a></li>
    <li class="navBar__item"><a href="/portal/domains" class="navBar__link">Domains</a></li>
    <li class="navBar__item"><a href="/portal/routes" class="navBar__link">Routing</a></li>
    <li class="navBar__item"><a href="/portal/credentials" class="navBar__link">Credentials</a></li>
    <li class="navBar__item"><a href="/portal/webhooks" class="navBar__link is-active">Webhooks</a></li>
    <li class="navBar__item"><a href="/portal/settings" class="navBar__link">Settings</a></li>
    <li class="navBar__item navBar__item--end"><a href="/portal/help/outgoing" class="navBar__link">Help</a></li>
  </ul>
</nav>
<nav class="navBar navBar--secondary">
  <ul>
    <li class="navBar__item"><a href="/portal/webhooks" class="navBar__link is-active">Manage Webhooks</a></li>
    <li class="navBar__item"><a href="/portal/webhooks/history" class="navBar__link">View History</a></li>
  </ul>
</nav>
<div class="pageContent pageContent--compact">
  <% if (webhooks.length === 0) { %>
    <div class="noData noData--clean">
      <h2 class="noData__title">No webhooks have been configured for this server.</h2>
      <p class="noData__text">You haven't added any webhooks for this server yet. A webhook enables your web application to be notified when certain events occur in the lifecycle of the mail server.</p>
      <p class="noData__button"><a href="/portal/webhooks/add" class="button button--positive">Add your first webhook</a></p>
    </div>
  <% } else { %>
    <ul class="webhookList u-margin">
      <% webhooks.forEach(function(w) { %>
        <li class="webhookList__item">
          <div class="webhookList__top">
            <p class="webhookList__name"><a href="/portal/webhooks/<%= w.id %>/edit"><%= w.name || w.endpoint_url %></a></p>
            <p class="webhookList__labels">
              <% if (w.enabled) { %><span class="label label--green">Enabled</span>
              <% } else { %><span class="label label--red">Disabled</span><% } %>
            </p>
          </div>
          <div class="webhookList__bottom">
            <p class="webhookList__usageTime">
              <% if (w.last_delivered_at) { %>Last sent request <%= timeAgo(w.last_delivered_at) %>.<% } else { %>Not used yet.<% } %>
            </p>
            <ul class="webhookList__links">
              <li class="webhookList__link"><a href="/portal/webhooks/<%= w.id %>/edit">Edit Webhook</a></li>
            </ul>
          </div>
        </li>
      <% }) %>
    </ul>
    <p class="u-center"><a href="/portal/webhooks/add" class="button button--positive">Add another webhook</a></p>
  <% } %>
</div>
