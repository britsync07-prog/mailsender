<div class="pageHeader">
  <h1 class="pageHeader__title">
    <span class="pageHeader__titlePrevious">Organization &rarr;</span>
    Webhooks
  </h1>
</div>

<nav class="navBar navBar--secondary">
  <ul>
    <li class="navBar__item"><a href="/portal/webhooks" class="navBar__link is-active">Webhooks</a></li>
  </ul>
</nav>

<div class="pageContent pageContent--compact">
  <% if (webhooks.length === 0) { %>
    <div class="noData noData--clean">
      <h2 class="noData__title">No webhooks</h2>
      <p class="noData__text">Webhooks allow you to subscribe to events which occur in this organization.</p>
      <p class="noData__button"><a href="/portal/webhooks/add" class="button button--positive">Add webhook</a></p>
    </div>
  <% } else { %>
    <ul class="itemList">
      <% webhooks.forEach(function(w) { %>
        <li class="itemList__item">
          <div class="itemList__details">
            <p class="itemList__name">
              <span class="label label--blue" style="margin-right:5px"><%= w.http_method || 'POST' %></span>
              <%= w.url %>
            </p>
            <p class="itemList__meta">
              <% if (w.enabled) { %>
                <span class="label label--green">Enabled</span>
              <% } else { %>
                <span class="label label--red">Disabled</span>
              <% } %>
              <% if (w.last_used_at) { %>
                &middot; Used <span class="u-relativeTime" data-timestamp="<%= new Date(w.last_used_at).getTime() %>"><%= timeAgo(w.last_used_at) %></span>
              <% } else { %>
                &middot; Never used
              <% } %>
              &middot; <a href="/portal/webhooks/<%= w.id %>/history" class="u-link">View history</a>
              (<strong><%= w.event_count || 0 %></strong> events)
            </p>
            <p class="itemList__actions">
              <a href="/portal/webhooks/<%= w.id %>/edit">Edit</a>
              <a href="javascript:toggleWebhook('<%= w.id %>')"><%= w.enabled ? 'Disable' : 'Enable' %></a>
              <a href="javascript:removeWebhook('<%= w.id %>')">Remove</a>
            </p>
          </div>
        </li>
      <% }) %>
    </ul>

    <p class="u-center"><a href="/portal/webhooks/add" class="button button--positive">Add webhook</a></p>
  <% } %>
</div>

<script>
async function toggleWebhook(id) {
  var r = await fetch('/api/portal/webhooks/' + id + '/toggle', { method: 'POST', headers: { 'Authorization':'Bearer <%= token %>' } });
  location.reload();
}

async function removeWebhook(id) {
  if (!confirm('Are you sure you want to remove this webhook?')) return;
  await fetch('/api/portal/webhooks/' + id, { method: 'DELETE', headers: { 'Authorization':'Bearer <%= token %>' } });
  location.reload();
}
</script>
