<div class="subPageBox__title">Choose a new password</div>
<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flashMessage<%= flash.type === 'notice' ? ' flashMessage--notice' : '' %>"><%= flash.message %></div>
<% } %>
<div class="subPageBox__content">
  <p class="subPageBox__text">If you've forgotten your password, just enter your e-mail address below and we'll send you an email with a link which will allow you to choose a new password.</p>
  <form action="/login/reset/<%= token %>" method="POST" class="loginForm">
    <p class="loginForm__input"><input type="password" name="password" class="input input--text input--onWhite" placeholder="Choose a new password" autofocus tabindex="1"></p>
    <p class="loginForm__input"><input type="password" name="password_confirmation" class="input input--text input--onWhite" placeholder="and enter it again to confirm" tabindex="2"></p>
    <div class="loginForm__submit">
      <ul class="loginForm__links">
        <li><a href="/login">Back to login</a></li>
      </ul>
      <button type="submit" class="button button--positive" tabindex="3">Login</button>
    </div>
  </form>
</div>
