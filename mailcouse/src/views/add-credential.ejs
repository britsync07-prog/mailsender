<div class="pageHeader">
  <h1 class="pageHeader__title">
    <span class="pageHeader__titlePrevious">Organization &rarr; Credentials &rarr;</span>
    Generate credentials
  </h1>
</div>

<nav class="navBar navBar--secondary">
  <ul>
    <li class="navBar__item"><a href="/portal/credentials" class="navBar__link">Credentials</a></li>
  </ul>
</nav>

<div class="pageContent pageContent--compact">
  <form action="/api/portal/credentials" method="POST" onsubmit="return generateCredential(event)">
    <fieldset class="fieldSet">
      <div class="fieldSet__field">
        <label class="fieldSet__label" for="cred-name">Name</label>
        <div class="fieldSet__input">
          <input type="text" id="cred-name" name="name" class="input input--text" autofocus placeholder="My Credential">
          <p class="fieldSet__text">A name to identify this credential.</p>
        </div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label" for="cred-domain">Domain</label>
        <div class="fieldSet__input">
          <select id="cred-domain" name="domainId" class="input input--select">
            <option value="">All domains</option>
            <% (domains || []).forEach(function(d) { %>
              <option value="<%= d.id %>"><%= d.domain %></option>
            <% }) %>
          </select>
          <p class="fieldSet__text">Optionally restrict this credential to a specific domain.</p>
        </div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label" for="cred-type">Type</label>
        <div class="fieldSet__input">
          <select id="cred-type" name="type" class="input input--select" style="width:120px">
            <option value="SMTP">SMTP</option>
            <option value="API">API</option>
          </select>
        </div>
      </div>
    </fieldset>
    <p class="fieldSetSubmit buttonSet">
      <button type="submit" class="button button--positive js-form-submit" id="add-btn">Generate</button>
      <a href="/portal/credentials" class="button button--neutral">Cancel</a>
    </p>
  </form>

  <div id="cred-result" class="u-hide" style="margin-top:30px">
    <div class="credDisplay">
      <label>Username</label>
      <code id="result-username"></code>
      <label>Password</label>
      <code id="result-password"></code>
    </div>
    <p class="u-margin" style="color:#999;font-size:12px;">Please save these credentials — the password will not be shown again.</p>
    <div class="buttonSet">
      <a href="/portal/credentials" class="button button--positive">Done</a>
    </div>
  </div>
</div>

<script>
async function generateCredential(e) {
  e.preventDefault();
  var name = document.getElementById('cred-name').value.trim();
  if (!name) { alert('Enter a credential name'); return false; }

  var btn = document.getElementById('add-btn');
  btn.disabled = true;
  btn.textContent = 'Generating...';

  try {
    var r = await fetch('/api/portal/credentials', {
      method: 'POST',
      headers: { 'Content-Type':'application/json','Authorization':'Bearer <%= token %>' },
      body: JSON.stringify({
        name: name,
        domainId: document.getElementById('cred-domain').value,
        type: document.getElementById('cred-type').value
      })
    });
    var data = await r.json();
    if (!r.ok) { alert(data.error); btn.disabled = false; btn.textContent = 'Generate'; return false; }

    document.getElementById('result-username').textContent = data.username;
    document.getElementById('result-password').textContent = data.password;
    document.getElementById('cred-result').classList.remove('u-hide');
    document.querySelector('.fieldSet').style.display = 'none';
    btn.style.display = 'none';
  } catch(e) {
    alert('Error: ' + e.message);
    btn.disabled = false;
    btn.textContent = 'Generate';
  }
  return false;
}
</script>
