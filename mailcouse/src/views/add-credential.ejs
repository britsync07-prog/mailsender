<div class="serverHeader">
  <div class="serverHeader__stripe serverHeader__stripe--<%= serverMode %>"><%= serverMode.charAt(0).toUpperCase() + serverMode.slice(1) %></div>
  <div class="serverHeader__info">
    <p class="serverHeader__title">Mail Server</p>
    <ul class="serverHeader__list">
      <li class="serverHeader__list--ok">DKIM &amp; SPF configured correctly</li>
    </ul>
  </div>
</div>
<nav class="navBar">
  <ul>
    <li class="navBar__item"><a href="/portal/dashboard" class="navBar__link">Overview</a></li>
    <li class="navBar__item"><a href="/portal/messages" class="navBar__link">Messages</a></li>
    <li class="navBar__item"><a href="/portal/domains" class="navBar__link">Domains</a></li>
    <li class="navBar__item"><a href="/portal/routes" class="navBar__link">Routing</a></li>
    <li class="navBar__item"><a href="/portal/credentials" class="navBar__link is-active">Credentials</a></li>
    <li class="navBar__item"><a href="/portal/webhooks" class="navBar__link">Webhooks</a></li>
    <li class="navBar__item"><a href="/portal/settings" class="navBar__link">Settings</a></li>
    <li class="navBar__item navBar__item--end"><a href="/portal/help/outgoing" class="navBar__link">Help</a></li>
  </ul>
</nav>
<div class="pageContent pageContent--compact">
  <% var cred = typeof credential !== 'undefined' ? credential : null; %>
  <% var availableDomains = typeof domains !== 'undefined' ? domains : []; %>
<% if (typeof error !== 'undefined' && error) { %>
    <div class="errorExplanation"><ul><li><%= error %></li></ul></div>
  <% } %>
  <form id="credential-form" onsubmit="saveCredential(event)">
    <fieldset class="fieldSet">
      <div class="fieldSet__field">
        <label class="fieldSet__label">Type</label>
        <div class="fieldSet__input">
          <select id="cred-type" class="input input--select" disabled <%= cred ? '' : 'autofocus' %>>
            <option value="smtp" selected>SMTP</option>
          </select>
          <p class="fieldSet__text">This credential authenticates SMTP clients with LOGIN or PLAIN.</p>
        </div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label">Name</label>
        <div class="fieldSet__input">
          <input type="text" id="cred-name" class="input input--text" autofocus="<%= cred ? 'autofocus' : '' %>" value="<%= cred ? cred.name : '' %>">
          <p class="fieldSet__text">This is a friendly name so you can identify this credential later. You can enter anything you want here, the more descriptive the better.</p>
        </div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label">Domain</label>
        <div class="fieldSet__input">
          <select id="cred-domain" class="input input--select">
            <option value="">Any verified domain</option>
            <% availableDomains.filter(function(d) { return d.verified; }).forEach(function(d) { %>
              <option value="<%= d.id %>" <%= cred && cred.customer_domain_id === d.id ? 'selected' : '' %>><%= d.domain %></option>
            <% }) %>
          </select>
          <p class="fieldSet__text">When a domain is selected, this credential can only send from that verified domain.</p>
        </div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label">SMTP Port</label>
        <div class="fieldSet__input">
          <select id="cred-tier" class="input input--select">
            <option value="mass_mail" <%= (!cred || cred.tier === 'mass_mail') ? 'selected' : '' %>>Mass mail</option>
            <option value="personal" <%= cred && cred.tier === 'personal' ? 'selected' : '' %>>Personal</option>
            <option value="transactional" <%= cred && cred.tier === 'transactional' ? 'selected' : '' %>>Transactional</option>
          </select>
          <p class="fieldSet__text">This must match the SMTP port used by the client.</p>
        </div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label">Allowed From</label>
        <div class="fieldSet__input">
          <input type="email" id="cred-allowed-from" class="input input--text input--code" placeholder="optional, e.g. sales@example.com" value="<%= cred && cred.allowed_from_email ? cred.allowed_from_email : '' %>">
          <p class="fieldSet__text">If set, SMTP clients using this credential can only send from this exact address.</p>
        </div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label">Default From Name</label>
        <div class="fieldSet__input">
          <input type="text" id="cred-default-name" class="input input--text" placeholder="optional, e.g. Sales Team" value="<%= cred && cred.default_from_name ? cred.default_from_name : '' %>">
          <p class="fieldSet__text">Used when the SMTP client sends only an email address without a display name.</p>
        </div>
      </div>
      <div class="fieldSet__field" data-credential-key-type="all">
        <label class="fieldSet__label">Key</label>
        <div class="fieldSet__input">
          <input type="text" id="cred-key" class="input input--text input--code" placeholder="Automatically generated" tabindex="1000" value="<%= cred ? cred.username : '' %>" <%= cred ? 'disabled' : '' %>>
          <p class="fieldSet__text">This is the unique key which will be used to authenticate any requests to the API or the SMTP servers. It will be generated randomly and cannot be changed. If you need a new token, you can create a new one and then delete the old one when you're ready.</p>
        </div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label">Hold</label>
        <div class="fieldSet__input">
          <select id="cred-hold" class="input input--select">
            <option value="false" <%= cred && cred.hold === false ? 'selected' : '' %>>Process all messages</option>
            <option value="true" <%= cred && cred.hold === true ? 'selected' : '' %>>Hold messages from this credential</option>
          </select>
          <p class="fieldSet__text">You may wish to automatically hold all messages that are sent by this credential. This allows you to preview them before they are delivered to their recipients. This is useful for credentials for development environments.</p>
        </div>
      </div>
    </fieldset>
    <div class="fieldSetSubmit buttonSet">
      <button type="submit" class="button button--positive js-form-submit"><%= cred ? 'Save credential' : 'Create credential' %></button>
      <% if (cred) { %>
        <span class="fieldSetSubmit__delete"><a href="javascript:deleteCredential()" class="button button--danger">Delete credential</a></span>
      <% } %>
    </div>
  </form>
</div>
<div id="credential-overlay" class="credentialOverlay" style="display:none;">
  <div class="credentialModal">
    <button type="button" class="credentialModal__close" onclick="closeCredentialModal()" aria-label="Close">&times;</button>
    <h3 class="credentialModal__title">Credential created</h3>
    <p class="credentialModal__text">Save these details now. The password will <b>not</b> be shown again.</p>
    <div class="credentialModal__field">
      <label class="credentialModal__label">Username</label>
      <div class="credentialModal__row">
        <input type="text" id="cred-created-username" class="input input--text input--code" readonly onclick="this.select()">
        <button type="button" class="button js-copy-btn" data-target="cred-created-username">Copy</button>
      </div>
    </div>
    <div class="credentialModal__field">
      <label class="credentialModal__label">Password</label>
      <div class="credentialModal__row">
        <input type="text" id="cred-created-password" class="input input--text input--code" readonly onclick="this.select()">
        <button type="button" class="button js-copy-btn" data-target="cred-created-password">Copy</button>
      </div>
    </div>
    <div class="credentialModal__field">
      <label class="credentialModal__label">SMTP Server</label>
      <div class="credentialModal__row">
        <input type="text" id="cred-created-server" class="input input--text input--code" readonly onclick="this.select()">
        <button type="button" class="button js-copy-btn" data-target="cred-created-server">Copy</button>
      </div>
    </div>
    <div class="credentialModal__field">
      <label class="credentialModal__label">SMTP Port</label>
      <div class="credentialModal__row">
        <input type="text" id="cred-created-port" class="input input--text input--code" readonly onclick="this.select()">
        <button type="button" class="button js-copy-btn" data-target="cred-created-port">Copy</button>
      </div>
    </div>
    <div class="credentialModal__actions">
      <a href="/portal/credentials" class="button button--positive">Continue</a>
    </div>
  </div>
</div>
</div>
<script>
async function saveCredential(e) {
  e.preventDefault();
  var btn = document.querySelector('#credential-form .js-form-submit');
  btn.textContent = 'Saving...'; btn.disabled = true;
  try {
    var body = {
      name: document.getElementById('cred-name').value,
      hold: document.getElementById('cred-hold').value,
      type: 'smtp',
      tier: document.getElementById('cred-tier').value,
      domainId: document.getElementById('cred-domain').value,
      allowed_from_email: document.getElementById('cred-allowed-from').value,
      default_from_name: document.getElementById('cred-default-name').value
    };
    var url = '<%= cred ? "/api/portal/credentials/" + cred.id : "/api/portal/credentials" %>';
    var r = await fetch(url, {
      method:'<%= cred ? "PUT" : "POST" %>',
      headers:{'Content-Type':'application/json','Authorization':'Bearer <%= token %>'},
      body:JSON.stringify(body)
    });
    var d = await r.json();
    if (!r.ok) throw new Error(d.error || 'Failed to save credential');
    if (d.id) {
      showCredentialModal(d.username || '', d.password || '', d.smtp_host || '', d.smtp_port || '');
      return;
    }
    location.href = '/portal/credentials';
  } catch(err) { alert('Error: ' + err.message); btn.textContent = '<%= cred ? "Save credential" : "Create credential" %>'; btn.disabled = false; }
}

function showCredentialModal(username, password, host, port) {
  document.getElementById('cred-created-username').value = username;
  document.getElementById('cred-created-password').value = password;
  document.getElementById('cred-created-server').value = host;
  document.getElementById('cred-created-port').value = port;
  document.getElementById('credential-overlay').style.display = 'flex';
}

function closeCredentialModal() {
  document.getElementById('credential-overlay').style.display = 'none';
}

document.addEventListener('click', function (e) {
  var btn = e.target.closest('.js-copy-btn');
  if (!btn) return;
  var input = document.getElementById(btn.getAttribute('data-target'));
  if (!input) return;
  var done = function (ok) {
    var old = btn.textContent;
    btn.textContent = ok ? 'Copied' : 'Failed';
    btn.disabled = true;
    setTimeout(function () { btn.textContent = old; btn.disabled = false; }, 1200);
  };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(input.value).then(function () { done(true); }, function () { done(false); });
  } else {
    input.select();
    try { done(document.execCommand('copy')); } catch (err) { done(false); }
  }
});

window.addEventListener('click', function (e) {
  var overlay = document.getElementById('credential-overlay');
  if (overlay && e.target === overlay) closeCredentialModal();
});
async function deleteCredential() {
  if (!confirm('Are you sure you wish to delete this credential?')) return;
  await fetch('<%= cred ? "/api/portal/credentials/" + cred.id : "" %>', { method:'DELETE', headers:{'Authorization':'Bearer <%= token %>'} });
  location.href = '/portal/credentials';
}
</script>
