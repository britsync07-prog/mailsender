<ul class="messageList">
  <% (messages || []).forEach(function(msg) { %>
    <li class="messageList__message">
      <a href="/portal/messages/<%= msg.id %>" class="messageList__link">
        <div class="messageList__details messageList__details--<%= msg.scope || 'outgoing' %>">
          <p class="messageList__subject"><%= msg.subject || 'No subject' %></p>
          <dl class="messageList__addresses">
            <dt>To</dt>
            <dd><% if (msg.rcpt_to_return_path) { %><span class="returnPathTag">Return Path</span><% } else { %><%= msg.rcpt_to || 'none' %><% } %></dd>
            <dt>From</dt>
            <dd><%= msg.mail_from || 'none' %></dd>
          </dl>
        </div>
        <div class="messageList__meta">
          <p class="messageList__timestamp"><%= new Date(msg.created_at || msg.timestamp).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric', hour:'numeric', minute:'2-digit'}) %></p>
          <p class="messageList__status">
            <span class="label label--messageStatus-<%= (msg.status || 'pending').replace(/ /g, '_') %>"><%= msg.status || 'pending' %></span>
          </p>
        </div>
      </a>
    </li>
  <% }) %>
</ul>
