<div class="subPageBox__title">Reset your password</div>
<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flashMessage<%= flash.type === 'notice' ? ' flashMessage--notice' : '' %>"><%= flash.message %></div>
<% } %>
<div class="subPageBox__content">
  <p class="subPageBox__text">If you've forgotten your password, just enter your e-mail address below and we'll send you an email with a link which will allow you to choose a new password.</p>
  <% if (typeof devLink !== 'undefined' && devLink) { %>
    <p class="subPageBox__text"><b>Development mode:</b> no e-mail will be sent, use this link instead: <a href="<%= devLink %>" class="u-link"><%= devLink %></a></p>
  <% } %>
  <form action="/login/reset" method="POST" class="loginForm">
    <p class="loginForm__input"><input type="text" name="email_address" class="input input--text input--onWhite" placeholder="Your e-mail address" autofocus tabindex="1"></p>
    <div class="loginForm__submit">
      <ul class="loginForm__links">
        <li><a href="/login">Back to login</a></li>
      </ul>
      <button type="submit" class="button button--positive" tabindex="3">Continue</button>
    </div>
  </form>
</div>
