<%- include('partials/server-header', { activeNav: 'domains', serverMode, serverName, totalDomains, unverifiedDomains, badDnsDomains, heldMessages, queuedMessages, bounceRate, diskUsed, outgoingPct, outgoingMessages, incomingMessages, messageRate, sendLimit }) %>
<%- include('partials/domains-nav', { activeNav: 'domains' }) %>
<div class="pageContent pageContent--compact">
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="errorExplanation"><ul><li><%= error %></li></ul></div>
  <% } %>
  <form id="new-domain-form" action="/api/portal/domains" method="POST" remote="true">
    <fieldset class="fieldSet">
      <div class="fieldSet__field">
        <label class="fieldSet__label" for="domain_name">Name</label>
        <div class="fieldSet__input"><input type="text" name="domain" id="domain_name" autofocus="autofocus" class="input input--text"></div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label" for="domain_verification_method">Verification method</label>
        <div class="fieldSet__input">
          <select name="verification_method" id="domain_verification_method" class="input input--select">
            <option value="DNS">DNS</option>
            <option value="Email">Email</option>
          </select>
          <p class="fieldSet__text">
            Choose how you'd like to verify your ownership of this domain. If you choose <b>E-Mail</b> we can send you
            an email with a code which you'll need to enter - you can choose from a set of pre-defined addresses for
            the domain. Using <b>DNS</b> you'll need to add a TXT record on this domain using your DNS provider.
          </p>
        </div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label" for="subdomain_count">Subdomain pool</label>
        <div class="fieldSet__input">
          <input type="number" name="subdomain_count" id="subdomain_count" min="0" max="500" value="24" class="input input--text">
          <p class="fieldSet__text">
            Create this many sending subdomains for the domain. They stay inactive until the domain is verified and DNS is checked.
          </p>
        </div>
      </div>
      <div class="fieldSet__field">
        <label class="fieldSet__label" for="naming_scheme">Subdomain names</label>
        <div class="fieldSet__input">
          <select name="naming_scheme" id="naming_scheme" class="input input--select">
            <option value="smtp">smtp001, smtp002...</option>
            <option value="mail">mail001, mail002...</option>
            <option value="outbound">out001, out002...</option>
            <option value="custom">Custom prefix</option>
          </select>
          <p class="u-margin"><input type="text" name="custom_prefix" id="custom_prefix" placeholder="custom prefix" class="input input--text"></p>
        </div>
      </div>
    </fieldset>
    <div class="fieldSetSubmit">
      <input type="submit" value="Add domain" class="button button--positive js-form-submit">
    </div>
  </form>
</div>
<script>
(function() {
  var form = document.getElementById('new-domain-form');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var btn = form.querySelector('.js-form-submit');
    btn.disabled = true;
    btn.value = 'Adding...';
    fetch('/api/portal/domains', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer <%= token %>' },
      body: JSON.stringify({ domain: form.domain.value, verification_method: form.verification_method.value, subdomain_count: form.subdomain_count.value, naming_scheme: form.naming_scheme.value, custom_prefix: form.custom_prefix.value })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.error) {
        var box = document.querySelector('.errorExplanation');
        if (!box) {
          box = document.createElement('div');
          box.className = 'errorExplanation';
          box.innerHTML = '<ul></ul>';
          form.insertBefore(box, form.firstChild);
        }
        box.querySelector('ul').innerHTML = '<li>' + data.error + '</li>';
        btn.disabled = false;
        btn.value = 'Add domain';
      } else if (data.redirect) {
        window.location.href = data.redirect;
      } else if (data.id) {
        window.location.href = '/portal/domains/' + data.id + '/verify';
      } else {
        btn.disabled = false;
        btn.value = 'Add domain';
      }
    }).catch(function() {
      btn.disabled = false;
      btn.value = 'Add domain';
    });
  });
})();
</script>
