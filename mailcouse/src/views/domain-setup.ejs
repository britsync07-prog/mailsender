<% function timeAgo(dateStr) {
  if (!dateStr) return null;
  var then = new Date(dateStr).getTime();
  var now = Date.now();
  var seconds = Math.floor((now - then) / 1000);
  if (seconds < 60) return 'less than a minute';
  var minutes = Math.floor(seconds / 60);
  if (minutes < 60) return minutes + (minutes === 1 ? ' minute' : ' minutes');
  var hours = Math.floor(minutes / 60);
  if (hours < 24) return hours + (hours === 1 ? ' hour' : ' hours');
  var days = Math.floor(hours / 24);
  return days + (days === 1 ? ' day' : ' days');
} %>
<%- include('partials/server-header', { activeNav: 'domains', serverMode, serverName, totalDomains, unverifiedDomains, badDnsDomains, heldMessages, queuedMessages, bounceRate, diskUsed, outgoingPct, outgoingMessages, incomingMessages, messageRate, sendLimit }) %>
<%- include('partials/domains-nav', { activeNav: 'domains' }) %>
<div class="pageContent pageContent--compact">
  <h2 class="pageContent__title">DNS Setup for <%= name %></h2>
  <p class="pageContent__intro u-margin">
    Follow the instructions below to configure SPF &amp; DKIM records for this domain.
    We highly recommend that you do this to ensure your messages are delivered
    correctly and quickly.
  </p>

  <div class="u-margin buttonSet">
    <button id="check-dns-btn" class="button">Check my records are correct</button>
    <a href="/portal/domains" class="button button--neutral">Back to domain list</a>
  </div>
  <div class="subPageBox u-margin">
    <h3 class="subPageBox__title">Sending Subdomains</h3>
    <p class="pageContent__text">
      This domain has <b><%= subdomainPool.total %></b> sending subdomains:
      <b><%= subdomainPool.active %></b> active,
      <b><%= subdomainPool.warming %></b> warming,
      <b><%= subdomainPool.inactive %></b> inactive.
    </p>
    <div class="buttonSet">
      <a href="/portal/subdomains?search=<%= encodeURIComponent(name) %>" class="button button--neutral">View subdomains</a>
      <button id="activate-subdomains-btn" class="button">Activate warmup</button>
    </div>
  </div>
  <% if (dnsCheckedAt) { %>
    <p class="u-margin">We last checked the validity of your DNS records <%= timeAgo(dnsCheckedAt) %> ago.</p>
  <% } %>

  <h3 class="pageContent__subTitle">SPF Record</h3>
  <% if (checks.spf.status === 'OK') { %>
    <p class="pageContent__text u-green u-bold">
      <span class="label label--green">Good</span>
      Your SPF record looks good!
    </p>
  <% } else if (checks.spf.status) { %>
    <p class="pageContent__text u-orange u-bold">
      <span class="label label--orange">Warning</span>
      <%= checks.spf.error %>
    </p>
  <% } %>

  <p class="pageContent__text">
    You need to add a TXT record at the apex/root of your domain (@) with the following
    content. If you already send mail from another service, you may just need to add
    <b>include:<%= spfInclude %></b> to your existing record.
  </p>
  <pre class="codeBlock u-margin"><%= spfRecord %></pre>

  <h3 class="pageContent__subTitle">DKIM Record</h3>
  <% if (checks.dkim.status === 'OK') { %>
    <p class="pageContent__text u-green u-bold">
      <span class="label label--green">Good</span>
      Your DKIM record looks good!
    </p>
  <% } else if (checks.dkim.status) { %>
    <p class="pageContent__text u-orange u-bold">
      <span class="label label--orange">Warning</span>
      <%= checks.dkim.error %>
    </p>
  <% } %>

  <p class="pageContent__text">
    You need to add a new TXT record with the name <b><%= dkimRecordName %></b>
    with the following content.
  </p>
  <pre class="codeBlock u-margin"><%= dkimRecord %></pre>

  <h3 class="pageContent__subTitle">Return Path</h3>
  <% if (checks.return_path.status === 'OK') { %>
    <p class="pageContent__text u-green u-bold">
      <span class="label label--green">Good</span>
      Your return path looks good. We'll use this when sending e-mail from this domain.
    </p>
  <% } else if (checks.return_path.status === 'Missing') { %>
    <p class="pageContent__text u-grey u-bold">
      <span class="label label--grey">OK</span>
      There's no return path for this domain. This is OK but we recommend adding the record to improve deliverability and achieve DMARC alignment.
    </p>
  <% } else if (checks.return_path.status) { %>
    <p class="pageContent__text u-orange u-bold">
      <span class="label label--orange">Warning</span>
      <%= checks.return_path.error %>
    </p>
  <% } %>

  <p class="pageContent__text">
    This is optional but we recommend adding this to improve deliverability. You should add
    a <b>CNAME</b> record at <b><%= returnPathDomain %></b> to point to the hostname below.
  </p>
  <pre class="codeBlock u-margin"><%= returnPathTarget %></pre>

  <h3 class="pageContent__subTitle">MX Records</h3>
  <% if (checks.mx.status === 'OK') { %>
    <p class="pageContent__text u-green u-bold">
      <span class="label label--green">Good</span>
      Your MX records look like they're good to go!
    </p>
  <% } else if (checks.mx.status === 'Missing') { %>
    <p class="pageContent__text u-grey u-bold">
      <span class="label label--grey">OK</span>
      None of the MX records for this domain point to us. Incoming mail won't be sent to us.
    </p>
  <% } else if (checks.mx.status) { %>
    <p class="pageContent__text u-orange u-bold">
      <span class="label label--orange">Warning</span>
      <%= checks.mx.error %>
    </p>
  <% } %>

  <p class="pageContent__text">
    If you wish to receive incoming e-mail for this domain, you need to add the following MX records
    to the domain. You don't have to do this and we'll only tell you if they're set up or not. Both
    records should be priority <b>10</b>.
  </p>
  <pre class="codeBlock u-margin"><%= mxRecords.join('\n') %></pre>
</div>
<script>
(function() {
  var activateBtn = document.getElementById('activate-subdomains-btn');
  if (activateBtn) {
    activateBtn.addEventListener('click', function() {
      activateBtn.disabled = true;
      activateBtn.textContent = 'Activating...';
      fetch('/api/portal/subdomains/activate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer <%= token %>' },
        body: JSON.stringify({ domain_id: '<%= id %>' })
      }).then(function(r) { return r.json(); }).then(function(data) {
        var count = data.activated || 0;
        window.location.href = '/portal/subdomains?search=<%= encodeURIComponent(name) %>&notice=' + encodeURIComponent(count + ' subdomains activated for warmup.');
      }).catch(function() {
        activateBtn.disabled = false;
        activateBtn.textContent = 'Activate warmup';
      });
    });
  }
  var btn = document.getElementById('check-dns-btn');
  if (!btn) return;
  btn.addEventListener('click', function() {
    btn.disabled = true;
    btn.textContent = 'Checking...';
    fetch('/api/portal/domains/<%= id %>/check', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer <%= token %>' }
    }).then(function(r) { return r.json(); }).then(function(data) {
      var url = data.redirect || '/portal/domains';
      if (data.flash) {
        url += (url.indexOf('?') === -1 ? '?' : '&') + (data.flash.notice ? 'notice=' : 'alert=') + encodeURIComponent(data.flash.notice || data.flash.alert);
      }
      window.location.href = url;
    }).catch(function() {
      btn.disabled = false;
      btn.textContent = 'Check my records are correct';
    });
  });
})();
</script>
