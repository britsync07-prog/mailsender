<div class="serverHeader">
  <div class="serverHeader__stripe serverHeader__stripe--<%= serverMode %>"><%= serverMode.charAt(0).toUpperCase() + serverMode.slice(1) %></div>
  <div class="serverHeader__info">
    <p class="serverHeader__title">Mail Server</p>
    <ul class="serverHeader__list">
      <li class="serverHeader__list--ok">DKIM &amp; SPF configured correctly</li>
    </ul>
  </div>
</div>
<nav class="navBar">
  <ul>
    <li class="navBar__item"><a href="/portal/dashboard" class="navBar__link">Overview</a></li>
    <li class="navBar__item"><a href="/portal/messages" class="navBar__link is-active">Messages</a></li>
    <li class="navBar__item"><a href="/portal/domains" class="navBar__link">Domains</a></li>
    <li class="navBar__item"><a href="/portal/routes" class="navBar__link">Routing</a></li>
    <li class="navBar__item"><a href="/portal/credentials" class="navBar__link">Credentials</a></li>
    <li class="navBar__item"><a href="/portal/webhooks" class="navBar__link">Webhooks</a></li>
    <li class="navBar__item"><a href="/portal/settings" class="navBar__link">Settings</a></li>
    <li class="navBar__item navBar__item--end"><a href="/portal/help/outgoing" class="navBar__link">Help</a></li>
  </ul>
</nav>
<nav class="navBar navBar--secondary">
  <ul>
    <li class="navBar__item"><a href="/portal/messages/outgoing" class="navBar__link <%= scope === 'outgoing' ? 'is-active' : '' %>">Outgoing Messages</a></li>
    <li class="navBar__item"><a href="/portal/messages/incoming" class="navBar__link <%= scope === 'incoming' ? 'is-active' : '' %>">Incoming Messages</a></li>
    <li class="navBar__item"><a href="/portal/messages/queue" class="navBar__link <%= scope === 'queue' ? 'is-active' : '' %>">Queue</a></li>
    <li class="navBar__item"><a href="/portal/messages/held" class="navBar__link <%= scope === 'held' ? 'is-active' : '' %>">Held</a></li>
    <li class="navBar__item"><a href="/portal/send" class="navBar__link <%= scope === 'send' ? 'is-active' : '' %>">Send Message</a></li>
    <li class="navBar__item"><a href="/portal/messages/suppressions" class="navBar__link <%= scope === 'suppressions' ? 'is-active' : '' %>">Suppressions</a></li>
  </ul>
</nav>
<div class="pageContent js-ajax-region">
  <% if (scope === 'suppressions') { %>
    <% if (!suppressions || suppressions.length === 0) { %>
      <div class="noData noData--clean">
        <h2 class="noData__title">No addresses on the suppression list.</h2>
        <p class="noData__text">When messages cannot be delivered, addresses are added to the suppression list which stops future messages to the same recipient being sent through.</p>
      </div>
    <% } else { %>
      <p class="pageContent__intro u-margin">When messages cannot be delivered, addresses are added to the suppression list which stops future messages to the same recipient being sent through. Recipients are removed from the list after 30 days.</p>
      <ul class="suppressionList">
        <% suppressions.forEach(function(s) { %>
          <li class="suppressionList__item">
            <div class="suppressionList__left">
              <p class="suppressionList__address"><a href="/portal/messages?search=to:<%= s.address || s.email %>"><%= s.address || s.email %></a></p>
              <p class="suppressionList__reason"><%= (s.reason || 'bounce').charAt(0).toUpperCase() + (s.reason || 'bounce').slice(1) %></p>
            </div>
            <div class="suppressionList__right">
              <p class="suppressionList__timestamp">Added <%= timeAgo(s.suppressed_at || s.timestamp) %></p>
              <p class="suppressionList__timestamp">Expires <%= timeAgo(s.keep_until) %><% if (new Date(s.keep_until) < new Date()) { %> <span class="u-red">expired</span><% } %></p>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  <% } else if (scope === 'queue') { %>
    <% if (messages.length === 0 && !search) { %>
      <div class="pageContent--compact">
        <div class="noData noData--clean">
          <h2 class="noData__title">Your queue is currently empty.</h2>
          <p class="noData__text">Messages which haven't yet been delivered successfully will appear in your queue until we've delivered them or we've given up trying.</p>
        </div>
      </div>
    <% } else { %>
      <%- include('messages/_search') %>
      <p class="pageContent__intro u-margin">All messages that pass through your mail server first enter this queue. Any messages that cannot be delivered immediately remain in the queue until they can be successfully delivered or we give up on them.</p>
      <% if (messages.length === 0) { %>
        <div class="noData noData--clean">
          <h2 class="noData__title">No messages found matching your filter.</h2>
          <p class="noData__text">There were no messages which matched the query that you entered. Sorry about that.</p>
        </div>
      <% } else { %>
        <%- include('messages/_list', { messages }) %>
        <% if (pagination && pagination.totalPages > 1) { %>
          <div class="simplePagination">
            <p class="simplePagination__previous">
              <% if (pagination.page > 1) { %><a href="?page=<%= pagination.page - 1 %><%= search ? '&search=' + search : '' %>" class="simplePagination__link">&larr; Previous page</a><% } %>
            </p>
            <div class="simplePagination__current">
              <p class="simplePagination__info">Showing <%= messages.length %> of <%= pagination.total %> messages</p>
              <p>Page <%= pagination.page %> of <%= pagination.totalPages %></p>
            </div>
            <p class="simplePagination__next">
              <% if (pagination.totalPages > pagination.page) { %><a href="?page=<%= pagination.page + 1 %><%= search ? '&search=' + search : '' %>" class="simplePagination__link">Next page &rarr;</a><% } %>
            </p>
          </div>
        <% } %>
      <% } %>
    <% } %>
  <% } else if (scope === 'held') { %>
    <% if (messages.length === 0 && !search) { %>
      <div class="pageContent--compact">
        <div class="noData noData--clean">
          <h2 class="noData__title">You haven't got any held messages.</h2>
          <p class="noData__text">You haven't sent any messages through this mail server yet. Not to worry though they'll start appearing here as soon as you start sending them.</p>
        </div>
      </div>
    <% } else { %>
      <%- include('messages/_search') %>
      <% if (messages.length === 0) { %>
        <div class="noData noData--clean">
          <h2 class="noData__title">No messages found matching your filter.</h2>
          <p class="noData__text">There were no messages which matched the query that you entered. Sorry about that.</p>
        </div>
      <% } else { %>
        <%- include('messages/_list', { messages }) %>
        <% if (pagination && pagination.totalPages > 1) { %>
          <div class="simplePagination">
            <p class="simplePagination__previous">
              <% if (pagination.page > 1) { %><a href="?page=<%= pagination.page - 1 %><%= search ? '&search=' + search : '' %>" class="simplePagination__link">&larr; Previous page</a><% } %>
            </p>
            <div class="simplePagination__current">
              <p class="simplePagination__info">Showing <%= messages.length %> of <%= pagination.total %> messages</p>
              <p>Page <%= pagination.page %> of <%= pagination.totalPages %></p>
            </div>
            <p class="simplePagination__next">
              <% if (pagination.totalPages > pagination.page) { %><a href="?page=<%= pagination.page + 1 %><%= search ? '&search=' + search : '' %>" class="simplePagination__link">Next page &rarr;</a><% } %>
            </p>
          </div>
        <% } %>
      <% } %>
    <% } %>
  <% } else if (messages.length === 0 && !search) { %>
    <div class="pageContent--compact">
      <div class="noData noData--clean">
        <% if (scope === 'outgoing') { %>
          <h2 class="noData__title">No messages have been sent yet.</h2>
          <p class="noData__text">You haven't sent any messages through this mail server yet. Not to worry though they'll start appearing here as soon as you start sending them.</p>
        <% } else { %>
          <h2 class="noData__title">No messages have been received yet.</h2>
          <p class="noData__text">You haven't received any messages through this mail server yet. Not to worry though they'll start appearing here as soon as you start receiving them.</p>
          <p class="noData__button"><a href="/portal/messages/incoming?search=spam:%20yes" class="button button--neutral">View spam messages</a></p>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <%- include('messages/_search') %>
    <% if (messages.length === 0) { %>
      <div class="noData noData--clean">
        <h2 class="noData__title">No messages found matching your filter.</h2>
        <p class="noData__text">There were no messages which matched the query that you entered. Sorry about that.</p>
      </div>
    <% } else { %>
      <%- include('messages/_list', { messages }) %>
      <% if (pagination && pagination.totalPages > 1) { %>
        <div class="simplePagination">
          <p class="simplePagination__previous">
            <% if (pagination.page > 1) { %><a href="?page=<%= pagination.page - 1 %><%= search ? '&search=' + search : '' %>" class="simplePagination__link">&larr; Previous page</a><% } %>
          </p>
          <div class="simplePagination__current">
            <p class="simplePagination__info">Showing <%= messages.length %> of <%= pagination.total %> messages</p>
            <p>Page <%= pagination.page %> of <%= pagination.totalPages %></p>
          </div>
          <p class="simplePagination__next">
            <% if (pagination.totalPages > pagination.page) { %><a href="?page=<%= pagination.page + 1 %><%= search ? '&search=' + search : '' %>" class="simplePagination__link">Next page &rarr;</a><% } %>
          </p>
        </div>
      <% } %>
    <% } %>
  <% } %>
</div>
