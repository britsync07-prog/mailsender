<!-- Server list page - shows current server info, no multi-server in MVP -->
<div class="pageHeader">
  <h1 class="pageHeader__title">Mail Servers</h1>
</div>
<div class="pageContent pageContent--compact">
  <p class="pageContent__intro u-margin">Your mail server is ready to send and receive e-mail.</p>
  <div class="largeList">
    <div class="largeList__item">
      <div class="largeList__link">
        <p class="largeList__title"><a href="/portal/dashboard">Mail Server</a></p>
        <p class="largeList__text"><%= serverMode === 'live' ? 'Live' : 'Development' %} mode</p>
      </div>
    </div>
  </div>
</div>
