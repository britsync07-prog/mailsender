<div class="subPageBox__title">Welcome to Postal</div>
<div class="subPageBox__content">
<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flashMessage<%= flash.type === 'notice' ? ' flashMessage--notice' : '' %>"><%= flash.message %></div>
<% } %>
<form action="/login" method="POST" class="loginForm">
  <div class="loginForm__input">
    <input type="email" name="email" class="input input--text input--onWhite" placeholder="Your e-mail address" autofocus>
  </div>
  <div class="loginForm__input">
    <input type="password" name="password" class="input input--text input--onWhite" placeholder="Your password">
  </div>
  <div class="loginForm__submit">
    <ul class="loginForm__links">
      <li><a href="/login/reset">Forgotten your password?</a></li>
    </ul>
    <button type="submit" class="button button--positive">Login</button>
  </div>
</form>
</div>
