<%- include('partials/server-header', { activeNav: 'domains', serverMode, serverName, totalDomains, unverifiedDomains, badDnsDomains, heldMessages, queuedMessages, bounceRate, diskUsed, outgoingPct, outgoingMessages, incomingMessages, messageRate, sendLimit }) %>
<%- include('partials/domains-nav', { activeNav: 'domains' }) %>
<div class="pageContent pageContent--compact">
<% if (verificationMethod === 'Email') { %>
  <% if (emailAddress) { %>
    <p class="pageContent__intro u-margin">
      We've sent an email to <b><%= emailAddress %></b>. Please check your e-mail and enter
      the code you've been sent in the box below.
    </p>
    <form id="email-code-form" action="/api/portal/domains/<%= domainId %>/verify" method="POST" remote="true">
      <input type="hidden" name="email_address" value="<%= emailAddress %>">
      <p class="u-margin">
        <input type="text" name="code" id="verification-code" autofocus="autofocus" class="input input--text js-multibox">
      </p>
      <div class="buttonSet">
        <input type="submit" value="Verify this domain" class="button js-form-submit">
        <a href="/portal/domains" class="button button--neutral">Back to domain list</a>
      </div>
    </form>
  <% } else { %>
    <p class="pageContent__intro u-margin">
      To verify your ownership of <b><%= domainName %></b> by e-mail, choose an e-mail address from the list
      below. We'll then send you an email with a code which you'll need to enter below.
    </p>
    <form id="email-select-form" action="/api/portal/domains/<%= domainId %>/verify" method="POST" remote="true">
      <p class="u-margin">
        <select name="email_address" id="email-address" class="input input--select" autofocus="autofocus">
          <% verificationEmailAddresses.forEach(function(addr) { %>
            <option value="<%= addr %>"><%= addr %></option>
          <% }) %>
        </select>
      </p>
      <p class="buttonSet">
        <input type="submit" value="Continue" class="button js-form-submit">
        <a href="/portal/domains" class="button button--neutral">Back to domain list</a>
      </p>
    </form>
  <% } %>
<% } else { %>
  <p class="pageContent__intro u-margin">
    To verify your ownership of <b><%= domainName %></b>, you need to add a TXT record to this domain.
    The TXT record should point to the domain and include the value shown below.
  </p>

  <pre class="codeBlock u-margin"><%= dnsVerificationString %></pre>

  <p class="pageContent__intro u-margin">
    Once you've added this, click the button below to verify the presence of this record and
    verify your domain.
  </p>

  <div class="buttonSet">
    <button id="verify-txt-btn" class="button js-form-submit">Verify TXT record</button>
    <a href="/portal/domains" class="button button--neutral">Back to domain list</a>
  </div>
<% } %>
</div>
<script>
(function() {
  var token = 'Bearer <%= token %>';

  function showFlash(data) {
    var box = document.querySelector('.flashMessage');
    if (box) box.remove();
    if (data && data.flash) {
      var el = document.createElement('div');
      el.className = 'flashMessage' + (data.flash.notice ? ' flashMessage--notice' : '');
      el.textContent = data.flash.notice || data.flash.alert;
      el.onclick = function() { this.remove(); };
      document.body.insertBefore(el, document.body.firstChild);
    }
  }

  function post(url, body) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': token },
      body: JSON.stringify(body)
    }).then(function(r) { return r.json(); });
  }

  var dnsBtn = document.getElementById('verify-txt-btn');
  if (dnsBtn) {
    dnsBtn.addEventListener('click', function() {
      dnsBtn.disabled = true;
      dnsBtn.textContent = 'Checking...';
      post('/api/portal/domains/<%= domainId %>/verify', {}).then(function(data) {
        if (data.verified && data.redirect) {
          window.location.href = data.redirect + (data.flash ? '?' + (data.flash.notice ? 'notice=' : 'alert=') + encodeURIComponent(data.flash.notice || data.flash.alert) : '');
        } else {
          showFlash(data);
          dnsBtn.disabled = false;
          dnsBtn.textContent = 'Verify TXT record';
        }
      }).catch(function() {
        dnsBtn.disabled = false;
        dnsBtn.textContent = 'Verify TXT record';
      });
    });
  }

  var emailSelectForm = document.getElementById('email-select-form');
  if (emailSelectForm) {
    emailSelectForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = emailSelectForm.querySelector('.js-form-submit');
      btn.disabled = true;
      post('/api/portal/domains/<%= domainId %>/verify', { email_address: emailSelectForm.email_address.value }).then(function(data) {
        if (data.redirect) {
          window.location.href = data.redirect;
        } else {
          showFlash(data);
          btn.disabled = false;
        }
      }).catch(function() { btn.disabled = false; });
    });
  }

  var emailCodeForm = document.getElementById('email-code-form');
  if (emailCodeForm) {
    emailCodeForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = emailCodeForm.querySelector('.js-form-submit');
      btn.disabled = true;
      post('/api/portal/domains/<%= domainId %>/verify', { code: emailCodeForm.code.value, email_address: emailCodeForm.email_address.value }).then(function(data) {
        if (data.verified && data.redirect) {
          window.location.href = data.redirect + (data.flash ? '?' + (data.flash.notice ? 'notice=' : 'alert=') + encodeURIComponent(data.flash.notice || data.flash.alert) : '');
        } else {
          showFlash(data);
          btn.disabled = false;
        }
      }).catch(function() { btn.disabled = false; });
    });
  }
})();
</script>
