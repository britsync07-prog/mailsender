<div class="pageHeader">
  <h1 class="pageHeader__title">
    <span class="pageHeader__titlePrevious">Organization &rarr;</span>
    Domains
  </h1>
</div>

<nav class="navBar navBar--secondary">
  <ul>
    <li class="navBar__item"><a href="/portal/domains" class="navBar__link is-active">Domains</a></li>
    <li class="navBar__item"><a href="/portal/track-domains" class="navBar__link">Tracking Domains</a></li>
  </ul>
</nav>

<div class="pageContent pageContent--compact">
  <% if (domains.length === 0) { %>
    <div class="noData noData--clean">
      <h2 class="noData__title">There are no domains for this server.</h2>
      <p class="noData__text">To send &amp; receive messages you need to add &amp; verify the domain you wish to send/receive messages to/from. Add your domain below to get started.</p>
      <p class="noData__button"><a href="/portal/domains/add" class="button button--positive">Add your first domain</a></p>
    </div>
  <% } else { %>
    <ul class="domainList u-margin">
      <% domains.forEach(function(d) { %>
        <li class="domainList__item">
          <div class="domainList__details">
            <p class="domainList__name">
              <a href="/portal/domains/<%= d.id %>/setup"><%= d.domain %></a>
              <% if (d.outgoing) { %><span class="label label--blue">Any</span><% } %>
            </p>
            <ul class="domainList__checks">
              <% if (d.spf_status === 'ok') { %>
                <li class="domainList__check domainList__check--ok" title="SPF record found">SPF</li>
              <% } else if (d.spf_status) { %>
                <li class="domainList__check domainList__check--warning" title="SPF record missing"><a href="/portal/domains/<%= d.id %>/setup">SPF</a></li>
              <% } else { %>
                <li class="domainList__check domainList__check--neutral" title="SPF not checked">SPF</li>
              <% } %>

              <% if (d.dkim_status === 'ok') { %>
                <li class="domainList__check domainList__check--ok" title="DKIM record found">DKIM</li>
              <% } else if (d.dkim_status) { %>
                <li class="domainList__check domainList__check--warning" title="DKIM record missing"><a href="/portal/domains/<%= d.id %>/setup">DKIM</a></li>
              <% } else { %>
                <li class="domainList__check domainList__check--neutral" title="DKIM not checked">DKIM</li>
              <% } %>

              <% if (d.mx_status === 'ok') { %>
                <li class="domainList__check domainList__check--ok" title="MX record found">MX</li>
              <% } else if (d.mx_status) { %>
                <li class="domainList__check domainList__check--neutral-cross" title="MX record missing"><a href="/portal/domains/<%= d.id %>/setup">MX</a></li>
              <% } else { %>
                <li class="domainList__check domainList__check--neutral" title="MX not checked">MX</li>
              <% } %>

              <% if (d.return_path_status === 'ok') { %>
                <li class="domainList__check domainList__check--ok" title="Return-Path found">Return-Path</li>
              <% } else if (d.return_path_status === 'missing') { %>
                <li class="domainList__check domainList__check--neutral" title="Return-Path missing"><a href="/portal/domains/<%= d.id %>/setup">Return-Path</a></li>
              <% } else if (d.return_path_status) { %>
                <li class="domainList__check domainList__check--warning" title="Return-Path error"><a href="/portal/domains/<%= d.id %>/setup">Return-Path</a></li>
              <% } else { %>
                <li class="domainList__check domainList__check--neutral" title="Return-Path not checked">Return-Path</li>
              <% } %>
            </ul>
          </div>
          <ul class="domainList__properties">
            <% if (d.verified) { %>
              <li class="domainList__verificationTime">Verified on <%= new Date(d.verified_at).toLocaleDateString() %></li>
            <% } else { %>
              <li><a href="/portal/domains/<%= d.id %>/verify" class="domainList__verificationLink">Verify this domain</a></li>
            <% } %>
            <li class="domainList__links">
              <a href="/portal/domains/<%= d.id %>/setup">DNS setup</a>
              <a href="javascript:deleteDomain('<%= d.id %>')" class="domainList__delete">Delete</a>
            </li>
          </ul>
        </li>
      <% }) %>
    </ul>

    <p class="u-center"><a href="/portal/domains/add" class="button button--positive">Add new domain</a></p>
  <% } %>
</div>

<script>
async function deleteDomain(id) {
  if (!confirm('Are you sure you wish to remove this domain?')) return;
  await fetch('/api/portal/domains/' + id, { method: 'DELETE', headers: { 'Authorization':'Bearer <%= token %>' } });
  location.reload();
}
</script>
