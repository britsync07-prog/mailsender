<%- include('partials/server-header', { activeNav: 'domains', serverMode, serverName, totalDomains, unverifiedDomains, badDnsDomains, heldMessages, queuedMessages, bounceRate, diskUsed, outgoingPct, outgoingMessages, incomingMessages, messageRate, sendLimit }) %>
<%- include('partials/domains-nav', { activeNav: 'domains' }) %>
<div class="pageContent pageContent--compact">
  <% if (domains.length === 0) { %>
    <div class="noData noData--clean">
      <h2 class="noData__title">There are no domains for this server.</h2>
      <p class="noData__text">
        To send &amp; receive messages you need to add &amp; verify the domain you wish to send/receive
        messages to/from. Add your domain below to get started.
      </p>
      <p class="noData__button"><a href="/portal/domains/add" class="button button--positive">Add your first domain</a></p>
    </div>
  <% } else { %>
    <ul class="domainList u-margin">
      <% domains.forEach(function(domain) { %>
        <li class="domainList__item">
          <div class="domainList__details">
            <p class="domainList__name">
              <a href="/portal/domains/<%= domain.id %>/setup"><%= domain.domain %></a>
              <% if (domain.use_for_any) { %>
                <span class="label label--blue">Any</span>
              <% } %>
            </p>
            <ul class="domainList__checks">
              <% if (domain.spf_status === 'OK') { %>
                <li class="domainList__check domainList__check--ok">SPF</li>
              <% } else if (domain.spf_status) { %>
                <li class="domainList__check domainList__check--warning" title="<%= domain.spf_error || '' %>"><a href="/portal/domains/<%= domain.id %>/setup">SPF</a></li>
              <% } %>

              <% if (domain.dkim_status === 'OK') { %>
                <li class="domainList__check domainList__check--ok">DKIM</li>
              <% } else if (domain.dkim_status) { %>
                <li class="domainList__check domainList__check--warning" title="<%= domain.dkim_error || '' %>"><a href="/portal/domains/<%= domain.id %>/setup">DKIM</a></li>
              <% } %>

              <% if (domain.mx_status === 'OK') { %>
                <li class="domainList__check domainList__check--ok">MX</li>
              <% } else if (domain.mx_status) { %>
                <li class="domainList__check domainList__check--neutral-cross" title="<%= domain.mx_error || '' %>"><a href="/portal/domains/<%= domain.id %>/setup">MX</a></li>
              <% } %>

              <% if (domain.return_path_status === 'OK') { %>
                <li class="domainList__check domainList__check--ok">Return Path</li>
              <% } else if (domain.return_path_status === 'Missing') { %>
                <li class="domainList__check domainList__check--neutral" title="<%= domain.return_path_error || '' %>"><a href="/portal/domains/<%= domain.id %>/setup">Return Path</a></li>
              <% } else if (domain.return_path_status) { %>
                <li class="domainList__check domainList__check--warning" title="<%= domain.return_path_error || '' %>"><a href="/portal/domains/<%= domain.id %>/setup">Return Path</a></li>
              <% } %>
            </ul>
          </div>

          <ul class="domainList__properties">
            <% if (domain.verified) { %>
              <li class="domainList__verificationTime">Verified on <%= new Date(domain.verified_at).toLocaleString(undefined, { month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></li>
            <% } else { %>
              <li><a href="/portal/domains/<%= domain.id %>/verify" class="domainList__verificationLink">Verify this domain</a></li>
            <% } %>
            <li class="domainList__links">
              <% if (domain.verified) { %>
                <a href="/portal/domains/<%= domain.id %>/setup">DNS setup</a>
              <% } %>
              <a href="javascript:void(0)" class="domainList__delete" data-domain-id="<%= domain.id %>" data-domain-name="<%= domain.domain %>">Delete</a>
            </li>
          </ul>
        </li>
      <% }) %>
    </ul>

    <p class="u-center"><a href="/portal/domains/add" class="button button--positive">Add new domain</a></p>
  <% } %>
</div>
<script>
(function() {
  var links = document.querySelectorAll('.domainList__delete');
  Array.prototype.forEach.call(links, function(link) {
    link.addEventListener('click', function() {
      var id = link.getAttribute('data-domain-id');
      var name = link.getAttribute('data-domain-name');
      if (!confirm('Are you sure you wish to remove this domain?')) return;
      link.textContent = 'Deleting...';
      fetch('/api/portal/domains/' + id, {
        method: 'DELETE',
        headers: { 'Authorization': 'Bearer <%= token %>' }
      }).then(function() { window.location.href = '/portal/domains'; });
    });
  });
})();
</script>
