<div class="pageHeader">
  <h1 class="pageHeader__title">
    <span class="pageHeader__titlePrevious">Organization &rarr;</span>
    Tracking Domains
  </h1>
</div>

<nav class="navBar navBar--secondary">
  <ul>
    <li class="navBar__item"><a href="/portal/domains" class="navBar__link">Domains</a></li>
    <li class="navBar__item"><a href="/portal/track-domains" class="navBar__link is-active">Tracking Domains</a></li>
  </ul>
</nav>

<div class="pageContent pageContent--compact">
  <% if (trackDomains.length === 0) { %>
    <div class="noData noData--clean">
      <h2 class="noData__title">No tracking domains</h2>
      <p class="noData__text">Tracking domains override the domain used for tracking links &amp; images.</p>
      <p class="noData__button"><a href="/portal/track-domains/add" class="button button--positive">Add tracking domain</a></p>
    </div>
  <% } else { %>
    <ul class="itemList">
      <% trackDomains.forEach(function(t) { %>
        <li class="itemList__item">
          <div class="itemList__details">
            <p class="itemList__name">
              <%= t.domain %>
              <% if (t.ssl_enabled) { %><span class="label label--green">SSL</span><% } %>
            </p>
            <p class="itemList__meta">
              <% if (t.dns_verified) { %>
                <span class="label label--green">OK</span>
              <% } else { %>
                <span class="label label--orange">Pending</span>
              <% } %>
              &middot; Created on <%= new Date(t.created_at).toLocaleDateString() %>
            </p>
            <p class="itemList__actions">
              <% if (!t.dns_verified) { %>
                <a href="javascript:checkTrackDomainDNS('<%= t.id %>')">Check DNS</a>
              <% } %>
              <a href="/portal/track-domains/<%= t.id %>/edit">Settings</a>
              <a href="javascript:removeTrackDomain('<%= t.id %>')">Delete</a>
            </p>
          </div>
        </li>
      <% }) %>
    </ul>

    <p class="u-center"><a href="/portal/track-domains/add" class="button button--positive">Add tracking domain</a></p>
  <% } %>
</div>

<script>
async function checkTrackDomainDNS(id) {
  var r = await fetch('/api/portal/track-domains/' + id + '/check', { method: 'POST', headers: { 'Authorization':'Bearer <%= token %>' } });
  location.reload();
}

async function removeTrackDomain(id) {
  if (!confirm('Are you sure you want to remove this tracking domain?')) return;
  await fetch('/api/portal/track-domains/' + id, { method: 'DELETE', headers: { 'Authorization':'Bearer <%= token %>' } });
  location.reload();
}
</script>
