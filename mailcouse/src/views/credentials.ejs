<div class="pageHeader">
  <h1 class="pageHeader__title">
    <span class="pageHeader__titlePrevious">Organization &rarr;</span>
    Credentials
  </h1>
</div>

<nav class="navBar navBar--secondary">
  <ul>
    <li class="navBar__item"><a href="/portal/credentials" class="navBar__link is-active">Credentials</a></li>
  </ul>
</nav>

<div class="pageContent pageContent--compact">
  <% if (credentials.length === 0) { %>
    <div class="noData noData--clean">
      <h2 class="noData__title">No credentials have been generated</h2>
      <p class="noData__text">Credentials are used to authenticate with our SMTP &amp; HTTP API.</p>
      <p class="noData__button"><a href="/portal/credentials/add" class="button button--positive">Generate credentials</a></p>
    </div>
  <% } else { %>
    <ul class="itemList">
      <% credentials.forEach(function(c) { %>
        <li class="itemList__item">
          <div class="itemList__details">
            <p class="itemList__name">
              <%= c.name %>
<span class="label label--credentialType-<%= c.type %>"><%= c.type || 'SMTP' %></span>
            </p>
            <p class="itemList__meta">
              Created on <%= new Date(c.created_at).toLocaleDateString() %>
<% if (c.last_used_at) { %>
  &middot; Used <span class="u-relativeTime" data-timestamp="<%= new Date(c.last_used_at).getTime() %>"><%= timeAgo(c.last_used_at) %></span>
<% } else { %>
  &middot; Never used
<% } %>
              <% if (c.hold) { %><span class="label label--red u-margin-left">Hold</span><% } %>
            </p>
            <p class="itemList__actions">
              <% if (c.type === 'SMTP') { %>
                <a href="javascript:showKey('<%= c.id %>')">View credentials</a>
              <% } %>
              <a href="javascript:removeCredential('<%= c.id %>')">Remove</a>
            </p>
          </div>
        </li>
      <% }) %>
    </ul>

    <p class="u-center"><a href="/portal/credentials/add" class="button button--positive">Generate credentials</a></p>
  <% } %>
</div>

<div id="credential-modal" class="modal" style="display:none">
  <div class="modal__backdrop" onclick="document.getElementById('credential-modal').style.display='none'"></div>
  <div class="modal__content">
    <div class="modal__header">
      <h3 class="modal__title">SMTP Credentials</h3>
      <button class="modal__close" onclick="document.getElementById('credential-modal').style.display='none'">&times;</button>
    </div>
    <div class="modal__body" id="credential-modal-body">
      <p>Username: <strong id="cred-user"></strong></p>
      <p>Password: <strong id="cred-pass"></strong></p>
    </div>
    <div class="modal__footer">
      <button class="button" onclick="document.getElementById('credential-modal').style.display='none'">Close</button>
    </div>
  </div>
</div>

<script>
async function showKey(id) {
  var r = await fetch('/api/portal/credentials/' + id + '/show', { headers: { 'Authorization':'Bearer <%= token %>' } });
  var data = await r.json();
  document.getElementById('cred-user').textContent = data.username;
  document.getElementById('cred-pass').textContent = data.password;
  document.getElementById('credential-modal').style.display = 'flex';
}

async function removeCredential(id) {
  if (!confirm('Are you sure you want to remove this credential?')) return;
  await fetch('/api/portal/credentials/' + id, { method: 'DELETE', headers: { 'Authorization':'Bearer <%= token %>' } });
  location.reload();
}
</script>
