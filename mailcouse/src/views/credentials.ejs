<div class="serverHeader">
  <div class="serverHeader__stripe serverHeader__stripe--<%= serverMode %>"><%= serverMode.charAt(0).toUpperCase() + serverMode.slice(1) %></div>
  <div class="serverHeader__info">
    <p class="serverHeader__title">Mail Server</p>
    <ul class="serverHeader__list">
      <li class="serverHeader__list--ok">DKIM &amp; SPF configured correctly</li>
    </ul>
  </div>
</div>
<nav class="navBar">
  <ul>
    <li class="navBar__item"><a href="/portal/dashboard" class="navBar__link">Overview</a></li>
    <li class="navBar__item"><a href="/portal/messages" class="navBar__link">Messages</a></li>
    <li class="navBar__item"><a href="/portal/domains" class="navBar__link">Domains</a></li>
    <li class="navBar__item"><a href="/portal/routes" class="navBar__link">Routing</a></li>
    <li class="navBar__item"><a href="/portal/credentials" class="navBar__link is-active">Credentials</a></li>
    <li class="navBar__item"><a href="/portal/webhooks" class="navBar__link">Webhooks</a></li>
    <li class="navBar__item"><a href="/portal/settings" class="navBar__link">Settings</a></li>
    <li class="navBar__item navBar__item--end"><a href="/portal/help/outgoing" class="navBar__link">Help</a></li>
  </ul>
</nav>
<div class="pageContent pageContent--compact">
  <% if (credentials.length === 0) { %>
    <div class="noData noData--clean">
      <h2 class="noData__title">There are no credentials for this server.</h2>
      <p class="noData__text">In order to authenticate to your mail server, you use credentials. Once you've added a credential, you'll have a unique token which you can use to authenticate against our SMTP service or our HTTP API.</p>
      <div class="noData__button"><a href="/portal/credentials/add" class="button button--positive">Add your first credential</a></div>
    </div>
  <% } else { %>
    <p class="pageContent__intro u-margin">In order to authenticate to your mail server, you use credentials. Once you've added a credential, you'll have a unique token which you can use to authenticate against our SMTP service or our HTTP API.</p>
    <p class="u-margin pageContent__helpLink"><a href="/portal/help/outgoing">Read more about sending outgoing e-mails</a></p>
    <ul class="credentialList u-margin">
      <% credentials.forEach(function(c) { %>
        <li class="credentialList__item">
          <a href="/portal/credentials/<%= c.id %>/edit" class="credentialList__link">
            <div class="credentialList__type">
              <span class="label label--credentialType-<%= (c.type || 'smtp').toLowerCase() %>"><%= (c.type || 'smtp').split('-').pop() %></span>
            </div>
            <div class="credentialList__properties">
              <p class="credentialList__name">
                <%= c.name %>
                <% if (c.hold) { %><span class="label label--red">Holding</span><% } %>
              </p>
              <p class="credentialList__key"><%= c.username %></p>
            </div>
            <div class="credentialList__usedAt credentialList__usedAt--<%= c.last_used_at ? 'active' : 'inactive' %>">
              <% if (c.last_used_at) { %>
                <p class="credentialList__usedAtTitle">Active</p>
                <p>Used <%= timeAgo(c.last_used_at) %></p>
              <% } else { %>
                <p>Not been used yet</p>
              <% } %>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>
    <p class="u-center buttonSet buttonSet--center"><a href="/portal/credentials/add" class="button button--positive">Add another credential</a></p>
  <% } %>
</div>
