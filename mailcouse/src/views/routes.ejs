<div class="pageHeader">
  <h1 class="pageHeader__title">
    <span class="pageHeader__titlePrevious">Organization &rarr;</span>
    Routes
  </h1>
</div>

<nav class="navBar navBar--secondary">
  <ul>
    <li class="navBar__item"><a href="/portal/routes" class="navBar__link is-active">Routes</a></li>
  </ul>
</nav>

<div class="pageContent pageContent--compact">
  <% if (routes.length === 0) { %>
    <div class="noData noData--clean">
      <h2 class="noData__title">No routes configured</h2>
      <p class="noData__text">Routes allow you to forward incoming messages to an external service.</p>
      <p class="noData__button"><a href="/portal/routes/add" class="button button--positive">Add route</a></p>
    </div>
  <% } else { %>
    <ul class="itemList">
      <% routes.forEach(function(r) { %>
        <li class="itemList__item">
          <div class="itemList__details">
            <p class="itemList__name">
              <span class="label label--blue"><%= r.endpoint_type %></span>
              <% if (r.endpoint_type === 'SMTP') { %>
                <span><%= r.smtp_host %>:<%= r.smtp_port %></span>
              <% } else if (r.endpoint_type === 'HTTP') { %>
                <span><%= r.http_url %></span>
              <% } else { %>
                <span><%= r.address %></span>
              <% } %>
            </p>
            <p class="itemList__meta">
              Span mode: <%= r.spam_mode || 'mark' %>
              &middot; Recipients: <strong><%= r.name %></strong>
            </p>
            <p class="itemList__actions">
              <a href="/portal/routes/<%= r.id %>/edit">Edit</a>
              <a href="javascript:removeRoute('<%= r.id %>')">Remove</a>
            </p>
          </div>
        </li>
      <% }) %>
    </ul>

    <p class="u-center"><a href="/portal/routes/add" class="button button--positive">Add route</a></p>
  <% } %>
</div>

<script>
async function removeRoute(id) {
  if (!confirm('Are you sure you want to remove this route?')) return;
  await fetch('/api/portal/routes/' + id, { method: 'DELETE', headers: { 'Authorization':'Bearer <%= token %>' } });
  location.reload();
}
</script>
